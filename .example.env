# Connect the gym registry to an external Factorio server instead of local Docker containers
# FACTORIO_SERVER_ADDRESS=localhost
# FACTORIO_SERVER_PORT=27000

# Offset for the port of the Factorio server when running multiple shells
PORT_OFFSET=0

# Override where the render tool looks for sprites (default: nearest .fle/sprites)
# FLE_SPRITES_DIR=.fle/sprites

# Only needed for fle/cluster/remote (AWS CloudFormation cluster)
CLUSTER_NAME=""
AWS_SECRET_ACCESS_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_DEFAULT_REGION=""
